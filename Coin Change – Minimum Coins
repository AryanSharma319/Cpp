#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;

void find(int target, int start, vector<int>& coins, vector<int>& current, vector<int>& ans)
{
    if(target==0)
    {
        auto count{current.size()};
        ans.push_back(count);
        return;
    }

    for(int i=start;i<coins.size();i++)
    {
        if(target>=coins[i])
        {
            current.push_back(coins[i]);

            find(target-coins[i],i,coins,current,ans);

            current.pop_back();
        }
    }
}

