#include<iostream>
#include<vector>
using namespace std;

void merge(vector<int>& arr, int start, int mid, int end)
{
    vector<int> temp;
    int i=start;
    int j=mid+1;
    while(i<=mid && j<=end)
    {
        if(arr[i]<arr[j])
        {
            temp.push_back(arr[i]);
            i++;
        }
        else
        {
            temp.push_back(arr[j]);
            j++;
        }
    }
    while(i<=mid)
    {
        temp.push_back(arr[i]);
        i++;
    }
    while(j<=end)
    {
        temp.push_back(arr[j]);
        j++;
    }
    for(int i=0;i<temp.size();i++)
    {
        arr[start+i]=temp[i];
    }
}

void merge_sort(vector<int>& arr, int start, int end)
{
    if(start<end)
    {
        int mid=start+(end-start)/2;
        merge_sort(arr,start,mid);
        merge_sort(arr,mid+1,end);
        merge(arr, start, mid, end);
    }
}

int main()
{
    int n{};
    cout<<"Enter n:";
    cin>>n;
    vector<int> arr;
    for(int i=0;i<n;i++)
    {
        int a{};
        cout<<"Enter element:";
        cin>>a;
        arr.push_back(a);
    }
    merge_sort(arr,0,n-1);
    for(int i=0;i<n;i++)
    {
        cout<<arr[i]<<" ";
    }
}
